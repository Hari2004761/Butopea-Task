<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_view_form_account" model="ir.ui.view">
        <field name="name">estate.property.form.account</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button"
                            name="action_view_invoices"
                            type="object"
                            icon="fa-pencil-square-o"
                            attrs="{'invisible': [('invoice_count', '=', 0)]}">
                        <field name="invoice_count" string="Invoices" widget="statinfo"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
